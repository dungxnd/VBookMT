apps/android/src/main/jniLibs/
apps/android/src/main/cpp/include/

# AGP's CMake configure output. Regenerated on every Gradle configure, and it accumulates object
# files for sources that may no longer exist (it held ct2_engine.cpp.o long after that file was
# deleted), so a stale copy is worse than none.
apps/android/.cxx/

