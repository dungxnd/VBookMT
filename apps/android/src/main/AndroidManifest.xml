<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="VBookMT"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- `libOpenCL.so` was declared here for QNN's GPU backend, which dlopens the absolute path
             `/vendor/lib64/libOpenCL.so` and is blocked by Android's linker namespace unless the
             library is declared. QNN is no longer bundled (its runtime was 180 MB of a 218 MB APK
             and its GPU path measured slower than CPU), so nothing in the app loads OpenCL and the
             declaration is gone with it. Re-add it alongside `onnxruntime-android-qnn` if that
             comes back. -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TranslationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
